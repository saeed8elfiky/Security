PUT _ingest/pipeline/logs-kaspersky_ksc.audit_admin
{
    "description": "A Kaspersky pipeline for parsing audit changes to administration groups",
    "processors": [
      {
        "append": {
          "field": "event.category",
          "value": [
            "audit",
            "configuration"
          ]
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter1",
          "target_field": "kaspersky.policy",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter2",
          "target_field": "user.changes",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter3",
          "target_field": "source.user.name",
          "ignore_missing": true
        }
      },
      {
        "remove": {
          "if": "ctx.user.changes == ctx.kaspersky.parameter5",
          "field": "kaspersky.parameter5",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter8",
          "target_field": "kaspersky.object.id",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter9",
          "target_field": "source.ip",
          "ignore_missing": true,
          "ignore_failure": true
        }
      },
      {
        "append": {
          "field": "user.name",
          "value": [
            "{{{user.changes}}}",
            "{{{source.user.name}}}"
          ],
          "allow_duplicates": false
        }
      },
      {
        "append": {
          "field": "related.ip",
          "value": [
            "{{{source.ip}}}"
          ],
          "allow_duplicates": false
        }
      }
    ],
    "on_failure": [
      {
        "set": {
          "field": "event.kind",
          "value": "pipeline_error"
        }
      },
      {
        "append": {
          "field": "error.message",
          "value": [
            "{{{ _ingest.on_failure_message }}}"
          ]
        }
      }
    ],
    "_meta": {
      "managed_by": "admin",
      "managed": "false",
      "package": {
        "name": "custom"
      }
  }
}