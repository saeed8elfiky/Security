PUT _ingest/pipeline/logs-kaspersky_ksc
{
    "description": "Parse Kaspersky logs",
    "processors": [
      {
        "set": {
          "field": "event.kind",
          "value": "event"
        }
      },
      {
        "grok": {
          "field": "message",
          "patterns": [
            """(?:<%{INT:log.syslog.priority}>%{INT:log.syslog.version} )?%{TIMESTAMP_ISO8601:@timestamp} %{HOSTNAME:user.hostname} %{DATA:log.syslog.appname} (?:- %{DATA:kaspersky.event} \[event@%{INT:event.code} %{GREEDYDATA:kv_part}\] )?%{GREEDYDATA:kaspersky.description}"""
          ]
        }
      },
      {
        "set": {
          "field": "event.original",
          "copy_from": "message",
          "ignore_empty_value": true
        }
      },
      {
        "remove": {
          "field": [
            "message",
            "kaspersky.event"
          ]
        }
      },
      {
        "append": {
          "field": "observer.vendor",
          "value": [
            "Kaspersky Security Center"
          ]
        }
      },
      {
        "kv": {
          "field": "kv_part",
          "field_split": """\" """,
          "value_split": "=\\\"",
          "ignore_missing": true,
          "trim_value": "\\\\\""
        }
      },
      {
        "remove": {
          "field": "kv_part",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "et",
          "target_field": "kaspersky.type",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "etdn",
          "target_field": "kaspersky.event_type",
          "ignore_missing": true
        }
      },
      {
        "drop": {
          "if": "ctx?.kaspersky?.event_type == 'Object corrupted'",
          "tag": "Drop",
          "ignore_failure": true
        }
      },
      {
        "rename": {
          "field": "tdn",
          "target_field": "kaspersky.category",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "gn",
          "target_field": "user.group.name",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "hip",
          "target_field": "kaspersky.hostip",
          "ignore_missing": true
        }
      },
      {
        "remove": {
          "field": "kaspersky.hostip",
          "ignore_missing": true,
          "if": "ctx?.kaspersky?.hostip == \"127.0.0.1\""
        }
      },
      {
        "convert": {
          "field": "kaspersky.hostip",
          "type": "ip",
          "ignore_missing": true,
          "if": "ctx?.kaspersky?.hostip == \"127.0.0.1\""
        }
      },
      {
        "rename": {
          "field": "hdn",
          "target_field": "kaspersky.computer_name",
          "ignore_missing": true
        }
      },
      {
        "set": {
          "ignore_failure": true,
          "field": "user.domain",
          "ignore_empty_value": true,
          "copy_from": "kaspersky.computer_name"
        }
      },
      {
        "remove": {
          "field": "p1",
          "ignore_missing": true,
          "if": "ctx.p1 == ctx.kaspersky.description",
          "ignore_failure": true
        }
      },
      {
        "rename": {
          "field": "p1",
          "target_field": "kaspersky.parameter1",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p2",
          "target_field": "kaspersky.parameter2",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p3",
          "target_field": "kaspersky.parameter3",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p4",
          "target_field": "kaspersky.parameter4",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p5",
          "target_field": "kaspersky.parameter5",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kscfqdn",
          "target_field": "log.syslog.hostname",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p8",
          "target_field": "kaspersky.parameter8",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p9",
          "target_field": "kaspersky.parameter9",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p6",
          "target_field": "kaspersky.parameter6",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "p7",
          "target_field": "kaspersky.parameter7",
          "ignore_missing": true
        }
      },
      {
        "pipeline": {
          "name": "logs-kaspersky_ksc.audit_conn",
          "if": "ctx?.kaspersky?.event_type == 'Audit (connection to the Administration Server)'"
        }
      },
      {
        "pipeline": {
          "name": "logs-kaspersky_ksc.audit_mod",
          "ignore_missing_pipeline": true,
          "if": "ctx?.kaspersky?.event_type == 'Audit (object modification)'"
        }
      },
      {
        "pipeline": {
          "name": "logs-kaspersky_ksc.audit_admin",
          "ignore_missing_pipeline": true,
          "if": "ctx?.kaspersky?.event_type == 'Audit (changes to the administration groups)'"
        }
      },
      {
        "pipeline": {
          "name": "logs-kaspersky_ksc.critical_status",
          "ignore_missing_pipeline": true,
          "if": "ctx.kaspersky.event_type == 'Device status is Critical.' || ctx.kaspersky.event_type == 'Device status is Warning.'",
          "ignore_failure": true
        }
      },
      {
        "pipeline": {
          "name": "logs-kaspersky_ksc.critical_malicous_object",
          "if": "ctx.kaspersky.event_type == 'Malicious object detected'"
        }
      },
      {
        "pipeline": {
          "name": "logs-kaspersky_ksc.critical_network_attack",
          "ignore_missing_pipeline": true,
          "if": "ctx.kaspersky.event_type == 'Network attack detected'",
          "ignore_failure": true
        }
      }
    ],
    "on_failure": [
      {
        "set": {
          "field": "event.kind",
          "value": "pipeline_error"
        }
      },
      {
        "append": {
          "field": "error.message",
          "value": [
            "{{{ _ingest.on_failure_message }}}"
          ]
        }
      }
    ],
    "_meta": {
      "managed_by": "admin",
      "managed": "false",
      "package": {
        "name": "custom"
      }
    }
  }