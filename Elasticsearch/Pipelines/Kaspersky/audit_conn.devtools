PUT _ingest/pipeline/logs-kaspersky_ksc.audit_conn
{
    "description": "A Kaspersky pipeline for parsing audit events",
    "processors": [
      {
        "append": {
          "field": "event.category",
          "value": [
            "connection",
            "audit"
          ]
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter2",
          "target_field": "source.ip",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter3",
          "target_field": "source.user.name",
          "ignore_missing": true
        }
      },
      {
        "set": {
          "field": "user.name",
          "copy_from": "source.user.name",
          "override": false,
          "ignore_empty_value": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter4",
          "target_field": "event.reason",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter5",
          "target_field": "source.address",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter9",
          "target_field": "source.nat.ip",
          "ignore_missing": true,
          "ignore_failure": true
        }
      },
      {
        "remove": {
          "field": "source.nat.ip",
          "ignore_missing": true,
          "if": "ctx.source.ip == ctx.source.nat.ip"
        }
      },
      {
        "append": {
          "field": "related.ip",
          "value": [
            "{{{source.ip}}}",
            "{{{source.address}}}",
            "{{{source.nat.ip}}}"
          ],
          "allow_duplicates": false
        }
      }
    ],
    "on_failure": [
      {
        "set": {
          "field": "event.kind",
          "value": "pipeline_error"
        }
      },
      {
        "append": {
          "field": "error.message",
          "value": [
            "{{{ _ingest.on_failure_message }}}"
          ]
        }
      }
    ],
    "_meta": {
      "managed_by": "admin",
      "managed": "false",
      "package": {
        "name": "custom"
      }
    }
}