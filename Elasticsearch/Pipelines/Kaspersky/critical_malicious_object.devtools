PUT _ingest/pipeline/logs-kaspersky_ksc.critical_malicous_object
{
    "description": "kaspersky event: malicious object detected",
    "processors": [
      {
        "rename": {
          "field": "kaspersky.parameter1",
          "target_field": "hash.sha256",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter2",
          "target_field": "file.name",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter7",
          "target_field": "user.name",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter5",
          "target_field": "kaspersky.threat_classification",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter8",
          "target_field": "kaspersky.threat_type",
          "ignore_missing": true
        }
      },
      {
        "set": {
          "field": "event.type",
          "override": false,
          "ignore_empty_value": true,
          "copy_from": "kaspersky.event_type"
        }
      }
    ]
}