PUT _ingest/pipeline/logs-kaspersky_ksc.audit_mod
{
    "description": "A Kaspersky pipeline for parsing audit modifications events",
    "processors": [
      {
        "append": {
          "field": "event.category",
          "value": [
            "audit",
            "configuration"
          ]
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter2",
          "target_field": "observer.product",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter3",
          "target_field": "source.user.name",
          "ignore_missing": true
        }
      },
      {
        "set": {
          "field": "user.name",
          "copy_from": "source.user.name",
          "override": false,
          "ignore_empty_value": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter4",
          "target_field": "observer.version",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter5",
          "target_field": "observer.type",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter8",
          "target_field": "kaspersky.object.id",
          "ignore_missing": true
        }
      },
      {
        "rename": {
          "field": "kaspersky.parameter9",
          "target_field": "client.ip",
          "ignore_missing": true,
          "ignore_failure": true
        }
      },
      {
        "append": {
          "field": "related.ip",
          "value": [
            "{{{client.ip}}}"
          ],
          "allow_duplicates": false
        }
      }
    ],
    "on_failure": [
      {
        "set": {
          "field": "event.kind",
          "value": "pipeline_error"
        }
      },
      {
        "append": {
          "field": "error.message",
          "value": [
            "{{{ _ingest.on_failure_message }}}"
          ]
        }
      }
    ],
    "_meta": {
      "managed_by": "admin",
      "managed": "false",
      "package": {
        "name": "custom"
      }
    }
}